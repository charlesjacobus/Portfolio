<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- See post-build event in project configuration and build/assets in angular.json -->
  <system.webServer>
    <directoryBrowse enabled="false" />
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
        <add value="default.htm" />
        <add value="default.asp" />
        <add value="index.htm" />
        <add value="default.aspx" />
        <add value="index.php" />
        <add value="index.asp" />
        <add value="_holding.htm" />
      </files>
    </defaultDocument>
    <staticContent>
      <!-- Along with cache-control configuration (below), encourages static content caching for 1 day -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
      <remove fileExtension=".ico" />
      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".md" mimeType="text/markdown" />
      <mimeMap fileExtension=".ico" mimeType="image/x-icon" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />
    </staticContent>
    <rewrite>
      <rules>
        <clear />
        <!-- Legacy pages from the old (ASP.NET / classic ASP / PHP) site: tell crawlers they are permanently gone (410) -->
        <rule name="Legacy pages gone" stopProcessing="true">
          <match url="\.(aspx?|ashx|asmx|php)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="This page no longer exists." />
        </rule>
        <!-- One canonical origin (https://charlesjacobus.com): www and/or http redirect there in a single hop -->
        <rule name="Redirect www to canonical host" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.charlesjacobus\.com$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://charlesjacobus.com/{R:0}" redirectType="Permanent" />
        </rule>
        <rule name="Redirect to https" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Serve sitemap.xml" stopProcessing="true">
          <match url="sitemap.xml" />
          <action type="Rewrite" url="sitemap.xml" />
        </rule>
        <rule name="Main Rule" stopProcessing="true">
          <match url="^(exhibits(/.*)?|leet|about|writings)/?$" ignoreCase="true" />
          <!-- Only real Angular routes get the SPA shell; anything else is a genuine 404 (not a soft 404) -->
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <httpErrors errorMode="DetailedLocalOnly" existingResponse="Auto" />
    <httpProtocol>
      <customHeaders>
        <add name="Cache-Control" value="public" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>